# ─────────────────────────────────────────────────────────────────────────────
# Déjà Dev — Environment Variable Reference
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must NEVER be committed to a public repo.
# ─────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────
# SUPABASE — client-side (safe to be public)
# ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# ──────────────────────────────────────────────────────
# SUPABASE — SERVER-ONLY SECRETS (never expose to browser)
# ──────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# SERVER-ONLY — DO NOT prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ──────────────────────────────────────────────────────
# GROQ — SERVER-ONLY SECRET
# ──────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
# This app uses Groq exclusively (model: openai/gpt-oss-20b)
GROQ_API_KEY=gsk_<key>

# ──────────────────────────────────────────────────────
# MEMWAL (Walrus Memory) — SERVER-ONLY SECRETS
# ──────────────────────────────────────────────────────
# How to obtain (STAGING environment only):
#   1. Go to https://staging.memory.walrus.xyz (NOT mainnet)
#   2. Create account -> copy Account Object ID -> MEMWAL_ACCOUNT_ID
#   3. Generate a Delegate Key -> copy hex -> MEMWAL_PRIVATE_KEY
#      WARNING: The delegate key is NOT your Sui wallet key. It is a separate
#      Ed25519 key the dashboard generates and registers on-chain.
#   4. Confirm the on-chain registration transaction completes before deploying.
#
# Environment isolation: staging keys ONLY work with the staging relayer.
# Using mainnet keys against staging relayer (or vice versa) -> HTTP 401.

MEMWAL_PRIVATE_KEY=<64-char-hex-or-suiprivkey1-bech32>
MEMWAL_ACCOUNT_ID=0x<object-id>
# Optional override (defaults to staging relayer):
# MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz

# ──────────────────────────────────────────────────────
# DIAGNOSTIC GATE — SERVER-ONLY
# ──────────────────────────────────────────────────────
# Protects GET /api/diag/memwal from public access in production.
# Set to a random 32+ char string; pass as Authorization: Bearer <token>.
# Leave unset in dev (route then only accepts localhost requests).
DIAG_SECRET=<random-string-min-32-chars>
